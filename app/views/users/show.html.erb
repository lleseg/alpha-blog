<div class="container py-5">
  <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-5">
    <div class="d-flex align-items-center gap-4">
      <div class="flex-shrink-0"><%= gravatar_for @user %></div>
      <h1 class="display-5 fw-bold mb-0"><%= @user.username %>'s profile</h1>
    </div>
    <%= link_to "Edit profile", edit_user_path(@user), class: "btn btn-outline-dark" %>
  </div>
  <h2 class="h4 fw-bold mb-3">Articles</h2>
  <%== @pagy.series_nav(:bootstrap, id: "pagination-nav", classes: "pagination pagination-sm") %>
  <div class="row row-cols-1 row-cols-md-2 g-4 mb-4">
    <%= render @user.articles %>
  </div>
  <%== @pagy.series_nav(:bootstrap, id: "pagination-nav", classes: "pagination pagination-sm") %>
</div>
