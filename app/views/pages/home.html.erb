<section class="home-hero bg-dark text-white" data-bs-theme="dark">
  <div class="container">
    <h1 class="display-3 fw-bold mb-3">Alpha Blog</h1>
    <p class="home-hero-lead fs-4 text-body-secondary mb-4">
      Short articles on whatever is worth writing down. Read what is here, or add your own.
    </p>
    <div class="d-flex flex-wrap gap-2">
      <%= link_to "Read articles", articles_path, class: "btn btn-light btn-lg" %>
      <%= link_to "Write an article", new_article_path, class: "btn btn-outline-light btn-lg" %>
    </div>
  </div>
</section>
