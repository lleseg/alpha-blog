<div class="container py-5">
  <h1 class="display-5 fw-bold mb-4">Category list</h1>
  <%== @pagy.series_nav(:bootstrap, id: "pagination-nav-top", classes: "pagination pagination-sm") if @pagy.pages > 1 %>
  <div class="row row-cols-1 row-cols-md-2 g-4 mb-4">
    <%= render @categories %>
  </div>
  <%== @pagy.series_nav(:bootstrap, id: "pagination-nav-bottom", classes: "pagination pagination-sm") if @pagy.pages > 1 %>
</div>
