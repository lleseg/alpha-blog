<div class="container py-5">
  <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-5">
    <h1 class="display-5 fw-bold mb-4"><%= @category.name %></h1>
    <% if logged_in? && current_user.admin? %>
      <%= link_to "Edit category", edit_category_path(@category), class: "btn btn-outline-dark" %>
    <% end %>
  </div>
  <h2 class="h4 fw-bold mb-3">Articles</h2>
  <%== @pagy.series_nav(:bootstrap, id: "pagination-nav", classes: "pagination pagination-sm") if @pagy.pages > 1 %>
  <div class="row row-cols-1 row-cols-md-2 g-4 mb-4">
    <%= render @articles %>
  </div>
  <%== @pagy.series_nav(:bootstrap, id: "pagination-nav", classes: "pagination pagination-sm") if @pagy.pages > 1 %>
</div>
