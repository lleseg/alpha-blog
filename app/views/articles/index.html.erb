<div class="container py-5">
  <h1 class="display-5 fw-bold mb-4">Article list</h1>
  <%== @pagy.series_nav(:bootstrap, id: "pagination-nav", classes: "pagination pagination-sm") if @pagy.pages > 1 %>
  <div class="row row-cols-1 row-cols-md-2 g-4 mb-4">
    <%= render @articles %>
  </div>
  <%== @pagy.series_nav(:bootstrap, id: "pagination-nav", classes: "pagination pagination-sm") if @pagy.pages > 1 %>
  <p class="my-4"><%= link_to 'Create new article', new_article_path, class: "link-offset-2 link-underline link-underline-opacity-25 link-underline-opacity-75-hover" %></p>
</div>
