<div class="container py-5">
  <h1 class="display-5 fw-bold mb-4">Article list</h1>
  <div class="row row-cols-1 row-cols-md-2 g-4">
    <% @articles.each do |article| %>
      <div class="col">
        <div class="card text-center h-100">
          <div class="card-header">
            <p class="fst-italic my-2"><%= article.user.username %></p>
          </div>
          <div class="card-body py-4 d-flex flex-column">
            <h5 class="card-title"><%= article.title %></h5>
            <p class="card-text"><%= truncate(article.description, length: 100) %></p>
            <div class="mt-auto">
              <%= link_to 'Show', article_path(article), class: "btn btn-dark" %>
              <%= link_to 'Edit', edit_article_path(article), class: "btn btn-outline-dark" %>
              <%= link_to 'Delete', article_path(article), class: "btn btn-outline-dark",
                                                           data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %>
            </div>
          </div>
          <div class="card-footer text-muted">
            <p class="my-2">Created <%= time_ago_in_words(article.created_at) %> ago, last edited <%= time_ago_in_words(article.updated_at) %> ago</p>
          </div>
        </div>
      </div>
    <% end %>
  </div>
  <p class="my-4"><%= link_to 'Create new article', new_article_path %></p>
</div>
