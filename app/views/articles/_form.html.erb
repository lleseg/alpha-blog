<% if article.errors.any? %>
  <div class="alert alert-danger" role="alert">
    <p id="alert-heading" class="fw-semibold mb-2">Errors were found when trying to save this article:</p>
    <ul class="mb-0">
      <% article.errors.full_messages.each do |error| %>
        <li><%= error %></li>
      <% end %>
    </ul>
  </div>
<% end %>
<%= form_with(model: article, local:true) do |form| %>
  <div class="mb-3">
    <%= form.label :title, class: "form-label" %>
    <%= form.text_field :title, class: "form-control" %>
  </div>
  <div class="mb-3">
    <%= form.label :description, class: "form-label" %>
    <%= form.text_area :description, class: "form-control" %>
  </div>
  <div class="mb-3">
    <%= form.label :category, class: "form-label" %>
    <%= form.select :category_ids, Category.all.order(:name).map { |category| [category.name, category.id] }, { prompt: "Select a category from the list below (more than one option available)" }, { multiple:true, class: "form-select", size: 4 } %>
  </div>
  <div class="mb-3">
    <%= form.submit(article.new_record? ? "Create" : "Update", class: "btn btn-dark") %>
  </div>
<% end %>
