<div class="container">
  <%= render 'shared/navbar' %>
  <div class="container text-center mt-4">
    <h1>Article details</h1>
    <br>
    <p><strong>Title: </strong><%= @article.title %></p>
    <p><strong>Description: </strong><%= @article.description %></p>
    <br>
    <%= link_to 'Edit', edit_article_path(@article) %> | <%= link_to 'Delete', article_path(@article), data:{ turbo_method: :delete, turbo_confirm: "Are you sure?" }  %> | <%= link_to 'Return to the list', articles_path %>
  </div>
</div>
