<div class="container py-5">
  <div class="col-lg-7">
    <h1 class="display-5 fw-bold mb-4"><%= @article.title %></h1>
    <div class="card text-center">
      <div class="card-header">
        <p class="fst-italic my-2">by <%= link_to @article.user.username, user_path(@article.user), class: "link-offset-2 link-underline link-underline-opacity-25 link-underline-opacity-75-hover" %></p>
        <% if @article.categories.any? %>
          <div class="mt-2"><%= render partial: "categories/badge", collection: @article.categories, as: :category %></div>
        <% end %>
      </div>
      <div class="card-body py-4">
        <div class="card-text"><%= simple_format(@article.description) %></div>
        <% if logged_in? && (@article.user == current_user || current_user.admin?) %>
          <%= link_to 'Edit', edit_article_path(@article), class: "btn btn-outline-dark" %>
          <%= link_to 'Delete', article_path(@article), class: "btn btn-outline-dark",
                                                      data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %>
        <% end %>
      </div>
      <div class="card-footer text-muted">
        <p class="my-2">Created <%= time_ago_in_words(@article.created_at) %> ago, last edited <%= time_ago_in_words(@article.updated_at) %> ago</p>
      </div>
    </div>
  </div>
</div>
