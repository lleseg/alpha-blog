<div class="container py-5">
  <div class="col-lg-7">
    <h1 class="display-5 fw-bold mb-4">Log in to Alpha Blog</h1>
    <%= form_with(scope: :session, url: login_path, local:true) do |form| %>
      <div class="mb-3">
        <%= form.label :email, class: "form-label" %>
        <%= form.email_field :email, class: "form-control" %>
      </div>
      <div class="mb-3">
        <%= form.label :password, class: "form-label" %>
        <%= form.password_field :password, class: "form-control" %>
      </div>
      <div class="mb-3">
        <%= form.submit "Log in", class: "btn btn-dark" %>
      </div>
    <% end %>
    <p class="mt-4"><%= link_to 'Return to the article list', articles_path, class: "link-offset-2 link-underline link-underline-opacity-25 link-underline-opacity-75-hover" %></p>
  </div>
</div>
