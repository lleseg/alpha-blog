<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1100;">
  <% flash.each do |name, message| %>
    <div class="toast align-items-center <%= name == 'alert' ? "text-bg-warning" : "text-bg-success" %>" role="alert" aria-live="assertive" aria-atomic="true" data-bs-autohide="true">
      <div class="d-flex">
        <div class="toast-body <%= "text-white" if name != 'alert' %>">
          <%= message %>
        </div>
      </div>
    </div>
  <% end %>
</div>
